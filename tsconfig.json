{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "strict": true,
    "paths": {},
    "moduleResolution": "Bundler",
    "allowJs": false,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
